<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Sign transactions with your Ledger hardware wallet over Bluetooth</string>
    <key>NSCameraUsageDescription</key>
    <string>Scan a recovery phrase QR code to restore an existing wallet</string>
    <key>NSFaceIDUsageDescription</key>
    <string>Unlock your wallet without typing your passphrase</string>
    <!-- Answers App Store Connect's export compliance prompt once here rather
         than per upload. True because the app's encryption falls outside the
         Category 5 Part 2 exemptions: rustls is a bundled TLS stack rather
         than the OS's, Brontide encrypts node P2P traffic for confidentiality
         (not just authentication), and stored secrets are sealed with
         AES-256-GCM. All of it is standard published crypto in a mass-market
         app, so it self-classifies as ECCN 5D992.c — which requires an annual
         self-classification report to BIS/NSA, not a licence. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <true/>
  </dict>
</plist>